# =============================================================================
# ChainPulse Production Configuration
# =============================================================================

# =============================================================================
# Required Configuration (MUST be set for production)
# =============================================================================

# Blockchain RPC URLs (comma-separated for multiple chains)
# Example: https://mainnet.infura.io/v3/YOUR_KEY,https://polygon-rpc.com
BLOCKCHAIN_NODE_URLS=https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Database connection (use strong password)
# Example: postgres://user:password@host:5432/chainpulse?sslmode=require
DATABASE_URL=postgres://chainpulse:CHANGE_ME@localhost:5432/chainpulse?sslmode=require

# JWT Secret for authentication (minimum 32 characters, use random string)
# Generate with: openssl rand -base64 32
API_JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING_AT_LEAST_32_CHARS

# =============================================================================
# Optional - Production Hardening
# =============================================================================

# TLS/HTTPS Configuration
GATEWAY_TLS_ENABLED=false
GATEWAY_TLS_CERT=/path/to/cert.pem
GATEWAY_TLS_KEY=/path/to/key.pem

# Rate Limiting (enable in production)
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_PER_MINUTE=1000

# =============================================================================
# Optional - Development Defaults
# =============================================================================

# Chains to index (comma-separated)
CHAINS=ethereum,polygon

# Worker configuration
WORKER_POOL_SIZE=8
BATCH_SIZE=100

# Cache
CACHE_TYPE=redis
CACHE_CONNECTION_URL=redis://localhost:6379

# Message Queue
MQ_TYPE=kafka
MQ_CONNECTION_URL=localhost:9092

# DLQ retention (7 days default)
MONOLITHIC_DLQ_RETENTION=168h

# Logging
LOG_LEVEL=info

# API Port
API_PORT=8080