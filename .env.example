# ChainPulse Local Development Configuration
# Copy this file to .env and replace placeholder values
# All variables support CHAINPULSE_ prefix (preferred) or bare names (legacy)

# Blockchain Node Configuration
CHAINPULSE_ETHEREUM_NODE_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
CHAINPULSE_ETHEREUM_NODE_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_PROJECT_ID

# PostgreSQL Configuration
CHAINPULSE_DATABASE_URL=postgres://chainpulse:REPLACE_ME@localhost:5432/chainpulse?sslmode=disable

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017

# Redis Configuration
CHAINPULSE_CACHE_CONNECTION_URL=localhost:6379

# gRPC Server Configuration
CHAINPULSE_GRPC_PORT=50051

# Server Configuration
CHAINPULSE_API_PORT=8080

# JWT Configuration
JWT_SECRET=REPLACE_ME_IN_PRODUCTION

# Authentication (monolithic mode)
# Enable JWT + API key authentication for API endpoints
CHAINPULSE_AUTH_ENABLED=false
# API keys in key=clientID format, comma-separated
# Example: CHAINPULSE_AUTH_API_KEYS=cp_abc123client1=client1,cp_def456client2=client2
CHAINPULSE_AUTH_API_KEYS=

# Rate Limit Configuration
RATE_LIMIT=10
RATE_LIMIT_BURST=20

# Batch Processing Configuration
CHAINPULSE_BATCH_SIZE=100
FLUSH_TIMEOUT=5

# Concurrency Configuration
CHAINPULSE_WORKER_POOL_SIZE=10
