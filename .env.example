# ChainPulse Local Development Configuration
# Copy this file to .env and replace placeholder values
# All variables support CHAINPULSE_ prefix (preferred) or bare names (legacy)

# Blockchain Node Configuration
CHAINPULSE_ETHEREUM_NODE_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
CHAINPULSE_ETHEREUM_NODE_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_PROJECT_ID

# Per-chain confirmation depth (blocks to wait before considering events finalized)
# Ethereum PoS: 64 blocks (~13 min), Polygon: 128 blocks, BSC: 15 blocks
# CHAINPULSE_ETHEREUM_CONFIRMATION_BLOCKS=64
# CHAINPULSE_POLYGON_CONFIRMATION_BLOCKS=128
# CHAINPULSE_BSC_CONFIRMATION_BLOCKS=15

# PostgreSQL Configuration
CHAINPULSE_DATABASE_URL=postgres://chainpulse:REPLACE_ME@localhost:5432/chainpulse?sslmode=disable

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017

# Redis Configuration
CHAINPULSE_CACHE_CONNECTION_URL=localhost:6379

# gRPC Server Configuration
CHAINPULSE_GRPC_PORT=50051

# Server Configuration
CHAINPULSE_API_PORT=8080

# JWT Configuration
JWT_SECRET=REPLACE_ME_IN_PRODUCTION

# Authentication (monolithic mode)
# Enable JWT + API key authentication for API enoints
CHAINPULSE_AUTH_ENABLED=false
# API keys in key=clientID format, comma-separated
# Example: CHAINPULSE_AUTH_API_KEYS=cp_abc123client1=client1,cp_def456client2=client2
CHAINPULSE_AUTH_API_KEYS=

# Rate Limit Configuration
RATE_LIMIT=10
RATE_LIMIT_BURST=20

# Batch Processing Configuration
CHAINPULSE_BATCH_SIZE=100
FLUSH_TIMEOUT=5

# Concurrency Configuration
CHAINPULSE_WORKER_POOL_SIZE=10

# OpenTelemetry Tracing (optional)
# OTEL_SERVICE_NAME=chainpulse
# OTEL_TRACES_SAMPLER_ARG=0.1

# Core Config Overrides (optional, overrides env-based defaults)
# CHAINPULSE_CORE_API_TYPE=rest
# CHAINPULSE_CORE_API_PORT=8080
# CHAINPULSE_CORE_FEATURE_FLAGS=feature_x=true,feature_y=false

# Runtime Environment Profile (development, staging, production)
# CHAINPULSE_ENV=development

# Cache Middleware Configuration (optional)
# CACHE_ENABLED=true
# CACHE_MAX_SIZE=10000
# CACHE_DEFAULT_TTL=300
# CACHE_CLEANUP_INTERVAL=60
# CACHE_EVICTION_STRATEGY=lru
# CACHE_WARMING_ENABLED=false
# CACHE_WARMING_INTERVAL=300

# Event Filter (optional, limits which events are indexed)
# CONTRACT_ADDRESSES=0x1234,0x5678
# EVENT_SIGNATURES=0xabcdef...

# Logging
# LOG_FORMAT=slog