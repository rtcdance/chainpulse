# ChainPulse Production Environment Template
#
# Copy this file to .env.production and fill in real values:
#   cp .env.production.template .env.production
#
# NEVER commit .env.production to version control.
# Use a secrets manager or CI/CD secret injection in production.

# === Runtime ===
CHAINPULSE_ENV=production
CHAINPULSE_LOG_LEVEL=info
CHAINPULSE_METRICS_ENABLED=true

# === RPC ===
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_RPC_KEY
RPC_CHAIN_ID=11155111

# === Gateway Security (P0: Required for production) ===
GATEWAY_AUTH_ENABLED=true
GATEWAY_AUTH_JWT_SECRET=REPLACE_WITH_256_BIT_SECRET
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT=1000

# API Keys (format: API_KEY=client_id)
# GATEWAY_AUTH_API_KEYS=key1=service-a,key2=service-b

# === Storage ===
DATABASE_URL=postgres://user:password@host:5432/chainpulse?sslmode=require
REDIS_URL=redis://host:6379/0?password=YOUR_REDIS_PASSWORD

# === Indexing ===
INDEXING_TARGET_BLOCK_HEIGHT=latest
INDEXING_REORG_MAX_ROLLBACK=120
INDEXING_CHECKPOINT_INTERVAL=100

# === Monitoring ===
PROMETHEUS_LISTEN=:9090
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
