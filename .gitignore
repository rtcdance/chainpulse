frontend/.vite/

# Package locks are NOT ignored. `npm ci` installs strictly from the lockfile and
# refuses to run without one ("EUSAGE: The `npm ci` command can only install with
# an existing package-lock.json"), so ignoring them made the frontend-api lane
# impossible: a fresh checkout had no lockfile and the first npm ci step failed.
# They were previously listed here, which is why frontend/package.json could
# declare `test: vitest run` while jsdom and the testing-library packages were
# absent from both the manifest and the lockfile.

# Go workspace
go.work.sum

# Test results
test-results/

# Scripts generated
scripts/mock-server/
/loadtest

# Foundry build artifacts (contracts/lib/ IS vendored and committed)
contracts/out/
contracts/cache/

# D20: this machine's global core.excludesFile has a blanket `scripts` pattern,
# which hides every NEW file under scripts/ from git (tracked ones are exempt).
# A repo .gitignore pattern outranks core.excludesFile, so re-include the dir;
# without this, scripts/bench/loadtest and any future script cannot be added.
!scripts/

# Python bytecode emitted by scripts/acceptance/*.py self-tests
__pycache__/
*.pyc
