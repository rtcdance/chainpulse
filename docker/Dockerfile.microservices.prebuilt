# ChainPulse Microservice - Pre-built Binary (Offline-Friendly)
# Build locally first:
#   CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
#     -o build/bin/linux/microservices/<service> ./cmd/microservices/<service>
#
# Uses alpine:3.19 as minimal runtime base (~7MB vs postgres:15-alpine ~200MB).
# No service needs postgres binaries locally — they connect over the network.
FROM alpine:3.19

ARG SERVICE
RUN apk add --no-cache ca-certificates curl

COPY build/bin/linux/microservices/${SERVICE} /usr/local/bin/service

EXPOSE 8080 8081 8082 8083 50051

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=10 \
  CMD curl -sf http://localhost:8080/health || exit 1

CMD ["service"]
