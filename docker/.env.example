# ChainPulse Docker Acceptance Environment Configuration
# Copy this file to .env and replace placeholder values before running docker compose

# Application Configuration
CHAINPULSE_LOG_LEVEL=INFO
CHAINPULSE_DEPLOYMENT_MODE=monolithic
CHAINPULSE_API_PORT=8080
CHAINPULSE_GRPC_PORT=50051
CHAINPULSE_METRICS_PORT=8081

# Data Puller Configuration
CHAINPULSE_DATA_PULLER_TYPE=https_jsonrpc
CHAINPULSE_PULLER_POLL_INTERVAL_MS=1000

# Cache Configuration
CHAINPULSE_CACHE_TYPE=redis
CHAINPULSE_CACHE_TTL_SECONDS=3600

# Database Configuration
CHAINPULSE_DATABASE_TYPE=postgres
CHAINPULSE_DATABASE_URL=postgres://chainpulse:REPLACE_ME@postgres:5432/chainpulse
DATABASE_URL=postgres://chainpulse:REPLACE_ME@postgres:5432/chainpulse

# Message Queue Configuration
CHAINPULSE_MQ_TYPE=kafka
CHAINPULSE_MQ_BROKERS=kafka:29092

# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017

# PostgreSQL Configuration
POSTGRES_USER=chainpulse
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=chainpulse

# Redis Configuration
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# Monitoring
PROMETHEUS_PORT=9090
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=REPLACE_ME

# JWT Configuration
JWT_SECRET=REPLACE_ME

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
