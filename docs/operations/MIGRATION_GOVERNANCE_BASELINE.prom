# HELP chainpulse_migration_items_by_severity Migration items grouped by severity.
# TYPE chainpulse_migration_items_by_severity gauge
chainpulse_migration_items_by_severity{severity="high"} 1
chainpulse_migration_items_by_severity{severity="medium"} 2

# HELP chainpulse_migration_items_by_domain Migration items grouped by domain.
# TYPE chainpulse_migration_items_by_domain gauge
chainpulse_migration_items_by_domain{domain="observability"} 3
